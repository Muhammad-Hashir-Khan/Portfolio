# ── Example environment file — copy to .env and fill in ────────────────
# Get a key at https://aistudio.google.com/apikey (kept server-side only)

# Required: Gemini API key
GEMINI_API_KEY=your_api_key_here

# Optional: model identifier (default: gemini-flash-lite-latest — see .env.example notes)
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: local server port (default: 8787)
PORT=8787
